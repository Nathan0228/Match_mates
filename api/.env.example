APP_ENV=development
PORT=8080
DB_PATH=data/matchmates.db
UPLOAD_DIR=uploads
ADMIN_EMAIL=admin@mails.ucas.ac.cn
# 64 位十六进制随机密钥；生产环境必填，设置后保持不变，否则已有优惠代码无法再次复制
PROMO_CODE_KEY=
# TMDB 作品搜索与海报：推荐填写 API Read Access Token；也可只填写 v3 API Key
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
# Production: the public Cloudflare Pages origin, e.g. https://example.pages.dev
FRONTEND_ORIGIN=https://localhost:5173
# Required in production for campus email verification and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
